# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Google OAuth
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/integrations/google/callback
GOOGLE_OAUTH_SCOPES=openid,email,profile,https://www.googleapis.com/auth/gmail.readonly,https://www.googleapis.com/auth/gmail.send,https://www.googleapis.com/auth/drive.readonly

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
SESSION_SECRET=

# PostgreSQL only; SQLite is deliberately unsupported.
DATABASE_URL=postgresql+asyncpg://trust_gate:trust_gate@localhost:5432/trust_gate
APP_ENV=development
MAX_DOCUMENT_BYTES=10485760
APPROVAL_TTL_MINUTES=30
LIVE_TEST_ENABLED=false
LIVE_TEST_RECIPIENT_ALLOWLIST=
